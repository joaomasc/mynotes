# Everything here is embedded in the public bundle. NEVER put secrets in VITE_* variables.

# Base URL of the Worker API (no trailing slash, without /api/v1)
VITE_API_URL=http://localhost:8787

# Path the app is served from. "/" locally or with a custom domain;
# "/<repository>/" on https://<user>.github.io/<repository>/
BASE_PATH=/
