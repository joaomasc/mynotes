{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mynotes-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true,
    // Request bodies and headers are never logged by the app; keep sampling low.
    "head_sampling_rate": 1
  },
  // Daily housekeeping (expired tokens, stale imports, abandoned uploads) and,
  // every 10 minutes, the semantic index of what changed (see knowledge-index.ts).
  "triggers": {
    "crons": ["17 4 * * *", "*/10 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mynotes",
      // Replace with the id printed by `wrangler d1 create mynotes` (see README).
      "database_id": "4349777e-1be1-4f9b-b47b-c01799eaca8b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "mynotes-files"
    }
  ],
  // Speech-to-text for dictated notes (Whisper) and embeddings for the assistant's
  // semantic search (bge-m3). Uses the account's daily free Neurons.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // Semantic index of notes and topics: derived from D1, rebuildable at any time.
  // Created with: wrangler vectorize create mynotes-knowledge --dimensions=1024 --metric=cosine
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "mynotes-knowledge",
      "remote": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    // Comma-separated exact origins allowed by CORS, e.g. "https://user.github.io".
    // Local development overrides this in .dev.vars.
    "ALLOWED_ORIGINS": "https://mynotes-web.joaomasc-dev.workers.dev,https://joaomasc.github.io",
    "SESSION_MAX_DAYS": "60",
    "SESSION_IDLE_DAYS": "14",
    // AI assistant (OpenAI Responses API). "false" turns it off without a redeploy of code.
    "AI_ENABLED": "true",
    // Any Responses-capable model with function calling; changing it needs no code change.
    "OPENAI_MODEL": "gpt-6-luna",
    // none | low | medium | high — lower is cheaper (reasoning tokens are billed as output).
    "AI_REASONING_EFFORT": "low",
    "AI_MAX_OUTPUT_TOKENS": "2000",
    // Tool calls the model may make in one chat turn (max 30: each runs in its own invocation, 32 per request).
    "AI_MAX_TOOL_CALLS": "30",
    "AI_MAX_REQUESTS_PER_MINUTE": "6",
    // Requests are refused once today's recorded spend (UTC) reaches this amount.
    "AI_DAILY_BUDGET_USD": "0.50",
    // USD per 1M tokens of OPENAI_MODEL, used to turn the usage reported by the API into cost.
    // Source: developers.openai.com/api/docs/pricing (gpt-6-luna, Standard, checked 2026-10-20).
    // Update together with OPENAI_MODEL.
    "AI_PRICE_INPUT_PER_MTOK": "0.10",
    "AI_PRICE_CACHED_INPUT_PER_MTOK": "0.01",
    "AI_PRICE_OUTPUT_PER_MTOK": "0.50",
    // OpenAI's hosted web search, only in messages where the user turns it on (globe button).
    // "false" hides it. Each search is billed per call on top of tokens: US$ 10 / 1k calls
    // (developers.openai.com/api/docs/pricing, checked 2026-10-20), counted in the daily budget.
    "AI_WEB_SEARCH": "true",
    "AI_MAX_WEB_SEARCHES": "5",
    "AI_PRICE_WEB_SEARCH_PER_CALL": "0.01"
  }
  // Secrets (never commit): AUTH_SECRET — set with `wrangler secret put AUTH_SECRET`;
  // OPENAI_API_KEY — set with `wrangler secret put OPENAI_API_KEY` (locally: apps/api/.dev.vars).
}
